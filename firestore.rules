rules_version = '2';

/* AutonoHealth stores only a signed-in person's profile, tracker template,
   and dated tracker entries. Every other client-visible path is denied. */
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validTemplate() {
      return request.resource.data.keys().hasOnly(['custom', 'hidden', 'order', 'updatedAt'])
        && request.resource.data.custom is list
        && request.resource.data.custom.size() <= 20
        && request.resource.data.hidden is list
        && request.resource.data.hidden.size() <= 27
        && request.resource.data.order is list
        && request.resource.data.order.size() <= 27
        && request.resource.data.updatedAt is timestamp;
    }

    function validEntry(entryId) {
      return entryId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['date', 'values', 'updatedAt'])
        && request.resource.data.date == entryId
        && request.resource.data.values is map
        && request.resource.data.values.size() <= 27
        && request.resource.data.updatedAt is timestamp;
    }

    match /users/{uid} {
      /* No profile copy is needed; Firebase Authentication already owns it.
         Delete remains available to clean up documents from older versions. */
      allow delete: if isOwner(uid);

      match /tracker/template {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validTemplate();
      }

      match /entries/{entryId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validEntry(entryId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
